#  Version  : 2.1.0
#  Author   : Kenny — BOOKWORM Project
#  Hardware : CIX Sky1 (CD8180) — ARM Linlon MVE v8 VPU
#  System   : Ubuntu 26.10 / 26.04.1, BOOKWORM Sky1 kernel (amvx driver)
#  Backend  : GStreamer (v4l2h264enc, v4l2h265enc, v4l2vp8enc, v4l2vp9enc)
#
#  YouTube  : @Kennytech73
#
#  Supported codecs (hardware encode) : H.264, HEVC (H.265), VP8, VP9
#
#  Why GStreamer and not FFmpeg :
#    The amvx driver reports NV12 with 2 planes and YU12 with 3 planes
#    (the V4L2 spec says 1). Stock FFmpeg then copies the whole picture
#    into plane 0 and the encoder gets no chroma. GStreamer follows the
#    plane count given by the driver and works with the stock packages.
#
#  Requirements :
#    - gstreamer1.0-tools, gstreamer1.0-plugins-base-apps (gst-launch, gst-discoverer)
#    - gstreamer1.0-plugins-good (v4l2 encoders, mp4mux, webmmux)
#    - gstreamer1.0-plugins-bad (h264parse/h265parse, voaacenc)
#    - gstreamer1.0-libav (avenc_aac, and the H.264/HEVC software decoders)
#    - User in 'video' group, /dev/video1 (MVX encoder device)
# =============================================================================

set -euo pipefail

# =============================================================================
# CONFIGURATION
# =============================================================================

VPU_DEVICE="/dev/video1"
VERSION="2.1.0"

# Colors — robust detection compatible with Gnome Terminal, sudo, SSH
# Force color if COLORTERM is set (Gnome Terminal sets this)
_has_color=false
if [[ -n "${COLORTERM:-}" ]]; then
    _has_color=true
elif [[ -t 1 ]] && command -v tput &>/dev/null && tput colors &>/dev/null 2>&1; then
    [[ $(tput colors) -ge 8 ]] && _has_color=true
fi

if [[ "${_has_color}" == true ]]; then
    RED='\033[0;31m'
    GREEN='\033[0;32m'
    YELLOW='\033[1;33m'
    BLUE='\033[0;34m'
    CYAN='\033[0;36m'
    BOLD='\033[1m'
    NC='\033[0m'
else
    RED='' GREEN='' YELLOW='' BLUE='' CYAN='' BOLD='' NC=''
fi

# Default encoding parameters
DEFAULT_CODEC="h264"
DEFAULT_BITRATE="4M"
AUDIO_BITRATE="${AUDIO_BITRATE:-}"     # empty = chosen from the channel count
AUDIO_CODEC="${AUDIO_CODEC:-auto}"     # auto (AAC for mp4, Opus for webm) or none

VPU_DECODE="${VPU_DECODE:-auto}"       # auto (VPU when the codec allows) or no (CPU)

# Seconds without any progress before the VPU decode path is given up
VPU_DECODE_TIMEOUT=20

# Inside decodebin the V4L2 decoders pick DMABuf output that the encoder
# refuses (not-negotiated), so decodebin always decodes on the CPU : the VPU
# decoder is only used in an explicit parsebin chain. GST_PLUGIN_FEATURE_RANK
# takes no wildcard here.
DECODE_RANKS="v4l2h264dec:NONE,v4l2h265dec:NONE,v4l2av1dec:NONE,v4l2vp8dec:NONE,v4l2vp9dec:NONE,v4l2mpeg2dec:NONE,v4l2mpeg4dec:NONE,v4l2h263dec:NONE"

# Without frame_level_rate_control_enable=1 the MVX firmware ignores
# video_bitrate (about 18 Mbit/s whatever is asked). Mode 0 = variable bitrate.
RATE_CONTROLS="frame_level_rate_control_enable=1,video_bitrate_mode=0"

WORK_DIR=""
GST_PID=""
GST_OWNER=""
INTERRUPTED=0
IN_BATCH=0
BATCH_STOP=0

# =============================================================================
# HELPERS
# =============================================================================

banner() {
    printf "%b" "${CYAN}"
    printf "╔══════════════════════════════════════════════════════════════╗\n"
    printf "║         BOOKWORM VPU Encoder — OrangePi 6 Plus               ║\n"
    printf "║         CIX P1 ARM Linlon MVE v8 — Hardware Acceleration     ║\n"
    printf "╚══════════════════════════════════════════════════════════════╝\n"
    printf "%b\n" "${NC}"
}

log_info()    { printf "%b\n" "${GREEN}[INFO]${NC}  $*"; }
log_warn()    { printf "%b\n" "${YELLOW}[WARN]${NC}  $*"; }
log_error()   { printf "%b\n" "${RED}[ERROR]${NC} $*" >&2; }
log_step()    { printf "%b\n" "${BLUE}[STEP]${NC}  $*"; }
log_result()  { printf "%b\n" "${BOLD}${GREEN}[DONE]${NC}  $*"; }

die() {
    log_error "$*"
    exit 1
}

cleanup() {
    [[ -n "${WORK_DIR}" && -d "${WORK_DIR}" ]] && rm -rf "${WORK_DIR}"
    return 0
}
trap cleanup EXIT

# Ctrl+C : gst-launch runs in its own session (setsid) so the terminal
# signal does not reach it directly ; the shell that started it forwards
# one SIGINT, which gst-launch -e turns into an end of stream : the file
# is closed properly (playable up to the point reached).
# The signal also reaches the command substitution subshells and, in batch
# mode, the main shell : they only note it.
on_interrupt() {
    if [[ -n "${GST_PID}" && "${BASHPID}" == "${GST_OWNER}" ]]; then
        if [[ "${INTERRUPTED}" -eq 0 ]] && kill -0 "${GST_PID}" 2>/dev/null; then
            INTERRUPTED=1
            printf "\n"
            log_warn "Interrupted — finishing the file up to the current position..."
            kill -INT "${GST_PID}" 2>/dev/null || true
        fi
    elif [[ "${BASHPID}" == "$$" ]]; then
        if [[ "${IN_BATCH}" -eq 1 ]]; then
            BATCH_STOP=1
        else
            exit 130
        fi
    fi
}
trap on_interrupt INT

# "4M", "800k", "4000000" → bits per second
to_bps() {
    local v="${1,,}"
    case "${v}" in
        *m) awk -v n="${v%m}" 'BEGIN { printf "%d", n * 1000000 }' ;;
        *k) awk -v n="${v%k}" 'BEGIN { printf "%d", n * 1000 }' ;;
        *[!0-9]*|"") return 1 ;;
        *) printf "%d" "${v}" ;;
    esac
}

have_element() {
    gst-inspect-1.0 --exists "$1" 2>/dev/null
}

# =============================================================================
# SYSTEM CHECKS
# =============================================================================

check_requirements() {
    log_step "Checking system requirements..."

    local tool
    for tool in gst-launch-1.0 gst-inspect-1.0; do
        command -v "${tool}" &>/dev/null || \
            die "${tool} not found. Install it: sudo apt install gstreamer1.0-tools"
    done
    command -v gst-discoverer-1.0 &>/dev/null || \
        die "gst-discoverer-1.0 not found. Install it: sudo apt install gstreamer1.0-plugins-base-apps"
    log_info "GStreamer : $(gst-launch-1.0 --version | awk 'NR==2 {print $2}')"

    # Check VPU device
    if [[ ! -e "${VPU_DEVICE}" ]]; then
        die "VPU device ${VPU_DEVICE} not found. Is the amvx kernel module loaded?"
    fi
    log_info "VPU device : ${VPU_DEVICE} ✓"

    # Check permissions
    if [[ ! -r "${VPU_DEVICE}" ]] || [[ ! -w "${VPU_DEVICE}" ]]; then
        log_warn "No access to ${VPU_DEVICE}."
        log_warn "Add your user to the 'video' group: sudo usermod -aG video \$USER"
        die "Permission denied on ${VPU_DEVICE}"
    fi
    log_info "VPU access : OK ✓"

    # Check kernel module — use multiple methods for robustness
    if ! grep -q "^amvx " /proc/modules 2>/dev/null && \
       ! [[ -d /sys/module/amvx ]]; then
        die "amvx kernel module not loaded. Run: sudo modprobe amvx"
    fi
    log_info "Kernel module : amvx ✓"

    # Hardware encoders (gstreamer1.0-plugins-good, video4linux2 plugin)
    local enc found=()
    for enc in v4l2h264enc v4l2h265enc v4l2vp8enc v4l2vp9enc; do
        have_element "${enc}" && found+=("${enc}")
    done
    [[ ${#found[@]} -gt 0 ]] || \
        die "No V4L2 hardware encoder in GStreamer. Install: sudo apt install gstreamer1.0-plugins-good"
    log_info "Encoders : ${found[*]} ✓"

    echo ""
}

# =============================================================================
# CODEC SELECTION
# =============================================================================

# Map codec name to "encoder parser muxer extension name"
get_codec_info() {
    local codec="$1"
    case "${codec,,}" in
        h264|avc)
            echo "v4l2h264enc h264parse mp4mux mp4 H.264/AVC"
            ;;
        hevc|h265)
            echo "v4l2h265enc h265parse mp4mux mp4 HEVC/H.265"
            ;;
        vp8)
            echo "v4l2vp8enc identity webmmux webm VP8"
            ;;
        vp9)
            echo "v4l2vp9enc identity webmmux webm VP9"
            ;;
        *)
            die "Unsupported codec '${codec}'. Supported: h264, hevc, vp8, vp9"
            ;;
    esac
}

# Caps forced after the encoder (H.264: High profile instead of the
# Constrained Baseline negotiated by default)
get_codec_caps() {
    case "$1" in
        v4l2h264enc) echo "video/x-h264,profile=high" ;;
        *)           echo "" ;;
    esac
}

# Audio encoder for a container : "element bitrate-property-unit"
# avenc_aac (gstreamer1.0-libav) first, voaacenc (plugins-bad) otherwise
get_audio_encoder() {
    local muxer="$1" bitrate_bps="$2"
    case "${muxer}" in
        webmmux)
            have_element opusenc || return 1
            echo "opusenc bitrate=${bitrate_bps}"
            ;;
        *)
            if have_element avenc_aac; then
                echo "avenc_aac bitrate=${bitrate_bps}"
            elif have_element voaacenc; then
                echo "voaacenc bitrate=${bitrate_bps}"
            else
                return 1
            fi
            ;;
    esac
}

# =============================================================================
# INPUT ANALYSIS (gst-discoverer-1.0)
# =============================================================================

# Sets PROBE_DURATION (seconds, may be empty), PROBE_HAS_VIDEO,
# PROBE_AUDIO_STREAMS, PROBE_CHANNELS (first audio stream) and the parsed
# caps of the first video and audio streams (PROBE_VIDEO_CAPS, PROBE_AUDIO_CAPS)
probe_input() {
    local input="$1" out
    out=$(LC_ALL=C gst-discoverer-1.0 -v "${input}" 2>/dev/null) || \
        die "Cannot read ${input} (unknown format or missing GStreamer plugin)"

    PROBE_DURATION=$(awk '/^ *Duration:/ {
        split($2, t, ":"); printf "%.2f", t[1]*3600 + t[2]*60 + t[3]; exit }' <<< "${out}")
    PROBE_HAS_VIDEO=$(grep -cE '^ *video #' <<< "${out}" || true)
    PROBE_AUDIO_STREAMS=$(grep -cE '^ *audio #' <<< "${out}" || true)
    PROBE_CHANNELS=$(awk '/^ *audio #/ { a = 1 }
        a && /^ *Channels:/ { print $2; exit }' <<< "${out}")
    PROBE_VIDEO_CAPS=$(sed -n 's/^ *video #[0-9]*: //p' <<< "${out}" | head -1)
    PROBE_AUDIO_CAPS=$(sed -n 's/^ *audio #[0-9]*: //p' <<< "${out}" | head -1)
}

# Prints "decoder parser" for a VPU decode of the probed video, or nothing.
# Only 8-bit 4:2:0 streams : the encoder takes NV12.
get_vpu_decoder() {
    local caps="${PROBE_VIDEO_CAPS}" dec parser
    [[ "${VPU_DECODE}" != "no" ]] || return 0
    case "${caps%%,*}" in
        video/x-h264) dec="v4l2h264dec"; parser="h264parse" ;;
        video/x-h265) dec="v4l2h265dec"; parser="h265parse" ;;
        video/x-vp8)  dec="v4l2vp8dec";  parser="" ;;
        video/x-vp9)  dec="v4l2vp9dec";  parser="vp9parse" ;;
        video/x-av1)  dec="v4l2av1dec";  parser="av1parse" ;;
        *) return 0 ;;
    esac
    [[ "${caps}" != *"bit-depth-luma=(uint)"* || "${caps}" == *"bit-depth-luma=(uint)8,"* \
        || "${caps}" == *"bit-depth-luma=(uint)8" ]] || return 0
    [[ "${caps}" != *"chroma-format="* || "${caps}" == *"chroma-format=(string)4:2:0"* ]] || return 0
    have_element "${dec}" || return 0
    if [[ -n "${parser}" ]] && ! have_element "${parser}"; then
        parser=""
    fi
    echo "${dec} ${parser}"
}

# Caps filter selecting the first audio stream out of parsebin
# ("audio/x-ac3", "audio/mpeg,mpegversion=4"…)
get_audio_filter() {
    local caps="${PROBE_AUDIO_CAPS}" mime version
    mime="${caps%%,*}"
    [[ "${mime}" == audio/* ]] || return 1
    version=$(grep -oE 'mpegversion=\(int\)[0-9]+' <<< "${caps}" | head -1 | sed 's/(int)//')
    if [[ -n "${version}" ]]; then
        echo "${mime},${version}"
    else
        echo "${mime}"
    fi
}

# =============================================================================
# ENCODING FUNCTIONS
# =============================================================================

# Fills PIPELINE. Video :
#   CPU : decodebin → videoconvert → NV12 (the format the VPU takes)
#   VPU : parsebin → parser → V4L2 decoder → NV12 in system memory
#   → progressreport → V4L2 encoder (VPU) → parser → muxer
# Audio : first stream → audioconvert/resample → AAC or Opus → muxer.
# The audio queue holds 5 s : the VPU decoder keeps many frames before
# the first one comes out, and the muxer waits for both streams.
build_pipeline() {
    local input="$1" output="$2" encoder="$3" caps="$4" parser="$5" muxer="$6"
    local video_bps="$7" audio_tail="$8" vpu_dec="${9:-}" vpu_parser="${10:-}"
    local audio_filter="${11:-}"
    local big_queue="queue max-size-buffers=0 max-size-bytes=0 max-size-time=5000000000"

    if [[ -n "${vpu_dec}" ]]; then
        PIPELINE=( filesrc location="${input}" ! parsebin name=d
            d. ! "${PROBE_VIDEO_CAPS%%,*}" ! queue )
        if [[ -n "${vpu_parser}" ]]; then
            PIPELINE+=( ! "${vpu_parser}" )
        fi
        PIPELINE+=( ! "${vpu_dec}" ! video/x-raw,format=NV12 )
    else
        PIPELINE=( filesrc location="${input}" ! decodebin name=d
            d. ! queue ! videoconvert ! video/x-raw,format=NV12 )
    fi
    PIPELINE+=( ! progressreport update-freq=1
        ! "${encoder}" extra-controls="encode,${RATE_CONTROLS},video_bitrate=${video_bps}" )
    if [[ -n "${caps}" ]]; then
        PIPELINE+=( ! "${caps}" )
    fi
    PIPELINE+=( ! "${parser}" ! queue ! "${muxer}" name=m ! filesink location="${output}" )
    if [[ -n "${audio_tail}" ]]; then
        # shellcheck disable=SC2206 # the audio branch is split on purpose
        if [[ -n "${vpu_dec}" ]]; then
            PIPELINE+=( d. ! "${audio_filter}" ! ${big_queue} ! decodebin ! ${audio_tail} )
        else
            PIPELINE+=( d. ! ${big_queue} ! ${audio_tail} )
        fi
    fi
}

# Runs PIPELINE with a progress display. Sets GST_RET (exit code) and
# GST_STALLED (1 when nothing came out within <timeout> seconds ; 0 = no limit)
run_pipeline() {
    local log_file="$1" timeout="$2"
    local start_time
    start_time=$(date +%s%N)
    GST_RET=0
    GST_STALLED=0

    LC_ALL=C GST_PLUGIN_FEATURE_RANK="${DECODE_RANKS}" \
        setsid gst-launch-1.0 -e "${PIPELINE[@]}" > "${log_file}" 2>&1 < /dev/null &
    GST_PID=$!
    GST_OWNER="${BASHPID}"

    # Ctrl+C also kills the short commands of the loop below (sleep, grep,
    # awk) : no errexit until gst-launch has finished
    set +e

    # Progress display loop — reads the progressreport lines :
    # "progressreport0 (00:00:05): 9 / 20 seconds (45.0 %)"
    printf "\n"
    local pos=0 total=0 pct=0 elapsed speed line
    while kill -0 "${GST_PID}" 2>/dev/null; do
        line=$(grep '^progressreport' "${log_file}" 2>/dev/null | tail -1 || true)
        elapsed=$(( ($(date +%s%N) - start_time) / 1000000 ))
        if [[ -z "${line}" ]]; then
            if [[ "${timeout}" -gt 0 && "${elapsed}" -gt $(( timeout * 1000 )) \
                    && "${INTERRUPTED}" -eq 0 ]]; then
                GST_STALLED=1
                kill -KILL "${GST_PID}" 2>/dev/null
            fi
        else
            read -r pos total pct < <(awk '{
                for (i = 1; i <= NF; i++) if ($i == "/") { print $(i-1), $(i+1) }
            }' <<< "${line}" | awk '{ printf "%d %d %d\n", $1, $2, ($2 > 0 ? $1 * 100 / $2 : 0) }')
            speed=$(awk -v p="${pos}" -v e="${elapsed}" 'BEGIN { printf "%.1f", (e > 0 ? p * 1000 / e : 0) }')

            local bar="" filled empty i
            if [[ "${total}" -gt 0 ]]; then
                filled=$(( pct * 30 / 100 ))
                empty=$(( 30 - filled ))
                bar="["
                for ((i=0; i<filled; i++)); do bar+="█"; done
                for ((i=0; i<empty; i++));  do bar+="░"; done
                bar+="] ${pct}%"
            fi

            printf "\r  %b%s%b  time=%02d:%02d:%02d  speed=%sx  " \
                "${CYAN}" "${bar}" "${NC}" \
                $(( pos / 3600 )) $(( pos % 3600 / 60 )) $(( pos % 60 )) "${speed}"
        fi
        sleep 0.5
    done

    # Wait for gst-launch to finish and get its exit code
    wait "${GST_PID}" || GST_RET=$?
    # A Ctrl+C interrupts the first wait : wait again for the end of stream
    while kill -0 "${GST_PID}" 2>/dev/null; do
        wait "${GST_PID}" || GST_RET=$?
    done
    GST_PID=""
    set -e
    printf "\n"
}

encode_single() {
    local input="$1"
    local output="$2"
    local codec="${3:-${DEFAULT_CODEC}}"
    local bitrate="${4:-${DEFAULT_BITRATE}}"

    # A ( ) subshell (batch mode) resets the traps : set it again here
    trap on_interrupt INT

    [[ -f "${input}" ]] || die "Input file not found: ${input}"

    local codec_info
    codec_info=$(get_codec_info "${codec}")
    local encoder parser muxer ext codec_name
    read -r encoder parser muxer ext codec_name <<< "${codec_info}"
    have_element "${encoder}" || die "${encoder} not available in GStreamer"

    local video_bps
    video_bps=$(to_bps "${bitrate}") || die "Invalid bitrate '${bitrate}' (examples: 4M, 800k)"

    # Auto-add extension if output has none
    if [[ "$(basename "${output}")" != *"."* ]]; then
        output="${output}.${ext}"
    fi
    [[ "$(readlink -f "${output}")" != "$(readlink -f "${input}")" ]] || \
        die "Output must be different from the input"

    log_step "Encoding: ${input}"
    log_info "Codec   : ${codec_name} (${encoder}, VPU)"
    log_info "Bitrate : ${bitrate}"
    log_info "Output  : ${output}"

    probe_input "${input}"
    [[ "${PROBE_HAS_VIDEO}" -gt 0 ]] || die "No video stream in ${input}"
    if [[ -n "${PROBE_DURATION}" ]]; then
        printf "  Duration : %s seconds\n" "${PROBE_DURATION}"
    fi

    # Audio : first audio stream only, re-encoded.
    # 128k is fine for stereo but catastrophic for 5.1 (~21k/channel)
    local audio_tail="" audio_bitrate="" audio_enc=""
    if [[ "${AUDIO_CODEC}" != "none" && "${PROBE_AUDIO_STREAMS}" -gt 0 ]]; then
        if [[ -n "${AUDIO_BITRATE}" ]]; then
            audio_bitrate="${AUDIO_BITRATE}"
        else
            case "${PROBE_CHANNELS}" in
                1) audio_bitrate="96k"  ;;  # mono
                2) audio_bitrate="128k" ;;  # stereo
                6) audio_bitrate="384k" ;;  # 5.1 — 64k/channel minimum
                8) audio_bitrate="512k" ;;  # 7.1 — 64k/channel minimum
                *) audio_bitrate="128k" ;;
            esac
        fi
        local audio_bps
        audio_bps=$(to_bps "${audio_bitrate}") || die "Invalid AUDIO_BITRATE '${audio_bitrate}'"
        audio_enc=$(get_audio_encoder "${muxer}" "${audio_bps}") || \
            die "No audio encoder for ${ext}. Install gstreamer1.0-libav (AAC) or gstreamer1.0-plugins-base (Opus), or set AUDIO_CODEC=none"
        audio_tail="audioconvert ! audioresample ! ${audio_enc} ! queue ! m."
        log_info "Audio   : ${PROBE_CHANNELS:-?}ch → ${audio_enc%% *} ${audio_bitrate}"
        if [[ "${PROBE_AUDIO_STREAMS}" -gt 1 ]]; then
            log_info "          (first of ${PROBE_AUDIO_STREAMS} audio streams kept)"
        fi
    else
        log_info "Audio   : none"
    fi

    # Decode on the VPU when the codec allows it (about 3x faster than the
    # CPU on a 1080p film), with the CPU as a fallback
    local vpu_dec="" vpu_parser="" audio_filter=""
    read -r vpu_dec vpu_parser <<< "$(get_vpu_decoder)"
    if [[ -n "${vpu_dec}" && -n "${audio_tail}" ]]; then
        audio_filter=$(get_audio_filter) || vpu_dec=""
    fi
    if [[ -n "${vpu_dec}" ]]; then
        log_info "Decode  : VPU (${vpu_dec})"
    else
        log_info "Decode  : CPU"
    fi
    echo ""

    local caps
    caps=$(get_codec_caps "${encoder}")

    WORK_DIR=$(mktemp -d)
    local log_file="${WORK_DIR}/gst.log"
    local start_time
    start_time=$(date +%s%N)

    local gst_ret
    if [[ -n "${vpu_dec}" ]]; then
        build_pipeline "${input}" "${output}" "${encoder}" "${caps}" "${parser}" "${muxer}" \
            "${video_bps}" "${audio_tail}" "${vpu_dec}" "${vpu_parser}" "${audio_filter}"
        run_pipeline "${log_file}" "${VPU_DECODE_TIMEOUT}"
        gst_ret=${GST_RET}
        # Nothing encoded : start again with the CPU decoder
        if [[ "${INTERRUPTED}" -eq 0 ]] && { [[ "${GST_STALLED}" -eq 1 ]] || \
                { [[ ${gst_ret} -ne 0 ]] && ! grep -q '^progressreport' "${log_file}"; }; }; then
            log_warn "VPU decode did not start — decoding on the CPU instead"
            rm -f "${output}"
            log_file="${WORK_DIR}/gst-cpu.log"
            start_time=$(date +%s%N)
            vpu_dec=""
        fi
    fi
    if [[ -z "${vpu_dec}" ]]; then
        build_pipeline "${input}" "${output}" "${encoder}" "${caps}" "${parser}" "${muxer}" \
            "${video_bps}" "${audio_tail}"
        run_pipeline "${log_file}" 0
        gst_ret=${GST_RET}
    fi

    if [[ "${INTERRUPTED}" -eq 1 && ${gst_ret} -eq 0 ]]; then
        log_warn "Stopped by the user : the output is complete up to the point reached"
    fi

    # Show errors if any
    if grep -qE '^(ERROR|ERREUR|WARNING)' "${log_file}"; then
        grep -E -A2 '^(ERROR|ERREUR|WARNING)' "${log_file}" | head -6 | \
            while IFS= read -r line; do
                printf "%b\n" "  ${YELLOW}${line}${NC}"
            done
    fi

    if [[ ${gst_ret} -ne 0 ]]; then
        die "GStreamer failed with exit code ${gst_ret}"
    fi

    local end_time
    end_time=$(date +%s%N)
    local elapsed_s
    elapsed_s=$(awk -v ns="$(( end_time - start_time ))" 'BEGIN { printf "%.2f", ns / 1e9 }')

    if [[ -f "${output}" && -s "${output}" ]]; then
        local size
        size=$(du -sh "${output}" | cut -f1)
        log_result "Done in ${elapsed_s}s — Output: ${output} (${size})"
    else
        die "Encoding failed or output file is empty"
    fi
    rm -rf "${WORK_DIR}"
    WORK_DIR=""
}

batch_encode() {
    local input_dir="$1"
    local output_dir="$2"
    local codec="${3:-${DEFAULT_CODEC}}"
    local bitrate="${4:-${DEFAULT_BITRATE}}"

    [[ -d "${input_dir}" ]] || die "Input directory not found: ${input_dir}"
    mkdir -p "${output_dir}" || die "Cannot create output directory: ${output_dir}"

    local codec_info
    codec_info=$(get_codec_info "${codec}")
    local encoder parser muxer ext codec_name
    read -r encoder parser muxer ext codec_name <<< "${codec_info}"

    # Find video files
    local files=()
    while IFS= read -r -d '' f; do
        files+=("$f")
    done < <(find "${input_dir}" -maxdepth 1 -type f \
        \( -iname "*.mp4" -o -iname "*.mkv" -o -iname "*.avi" \
           -o -iname "*.mov" -o -iname "*.ts"  -o -iname "*.webm" \
           -o -iname "*.flv" -o -iname "*.wmv" -o -iname "*.m4v" \) \
        -print0)

    if [[ ${#files[@]} -eq 0 ]]; then
        die "No video files found in ${input_dir}"
    fi

    log_info "Found ${#files[@]} file(s) to encode"
    log_info "Codec   : ${codec_name}"
    log_info "Bitrate : ${bitrate}"
    log_info "Output  : ${output_dir}"
    echo ""

    # Each file runs in a subshell : die() stops that file only.
    # Ctrl+C finishes the current file and stops the batch.
    local success=0 failed=0 i=1
    IN_BATCH=1
    for input in "${files[@]}"; do
        local basename
        basename=$(basename "${input%.*}")
        local output="${output_dir}/${basename}_${codec,,}.${ext}"

        printf "%b\n" "${BOLD}[${i}/${#files[@]}] ${basename}${NC}"
        if ( encode_single "${input}" "${output}" "${codec}" "${bitrate}" ); then
            (( success++ )) || true
        else
            log_error "Failed: ${input}"
            (( failed++ )) || true
        fi
        (( i++ )) || true
        echo ""
        if [[ "${BATCH_STOP}" -eq 1 ]]; then
            log_warn "Batch stopped by the user"
            break
        fi
    done
    IN_BATCH=0

    printf "%b\n" "${BOLD}═══════════════════════════════════${NC}"
    log_result "Batch complete — Success: ${success} | Failed: ${failed}"
}

benchmark() {
    log_step "Running VPU benchmark (1080p 30fps, 10 seconds = 300 frames)..."
    echo ""

    local codecs=("h264" "hevc" "vp8" "vp9")
    local results=()
    local frames=300

    WORK_DIR=$(mktemp -d)

    for codec in "${codecs[@]}"; do
        local codec_info
        codec_info=$(get_codec_info "${codec}")
        local encoder parser muxer ext codec_name
        read -r encoder parser muxer ext codec_name <<< "${codec_info}"

        printf "  Testing %-12s : " "${codec_name}"

        if ! have_element "${encoder}"; then
            printf "%b\n" "${RED}not available${NC}"
            results+=("${codec_name}|-|-|-")
            continue
        fi

        local tmpout="${WORK_DIR}/bench.${ext}"
        local start end elapsed_ms
        start=$(date +%s%N)

        if LC_ALL=C gst-launch-1.0 -q \
            videotestsrc num-buffers="${frames}" pattern=smpte \
            ! video/x-raw,format=NV12,width=1920,height=1080,framerate=30/1 \
            ! "${encoder}" extra-controls="encode,${RATE_CONTROLS},video_bitrate=4000000" \
            ! "${parser}" ! "${muxer}" ! filesink location="${tmpout}" \
            > "${WORK_DIR}/bench.log" 2>&1; then
            end=$(date +%s%N)
            elapsed_ms=$(( (end - start) / 1000000 ))
            local fps speed size
            fps=$(awk -v f="${frames}" -v e="${elapsed_ms}" 'BEGIN { printf "%.0f", f * 1000 / e }')
            speed=$(awk -v e="${elapsed_ms}" 'BEGIN { printf "%.1f", 10000 / e }')
            size=$(du -k "${tmpout}" | cut -f1)KiB
            printf "%b\n" "${GREEN}${fps} fps${NC} | ${speed}x realtime | ${size}"
            results+=("${codec_name}|${fps}|${speed}|${size}")
        else
            printf "%b\n" "${RED}FAILED${NC}"
            results+=("${codec_name}|FAILED|FAILED|0")
        fi
        rm -f "${tmpout}"
    done

    echo ""
    printf "%b\n" "${BOLD}════════════════════════════════════════════════════${NC}"
    printf "%b\n" "${BOLD}  BOOKWORM VPU Benchmark Results — OrangePi 6 Plus  ${NC}"
    printf "%b\n" "${BOLD}════════════════════════════════════════════════════${NC}"
    printf "  %-20s %-10s %-12s %s\n" "Codec" "FPS" "Speed" "Size"
    printf "  %-20s %-10s %-12s %s\n" "─────" "───" "─────" "────"
    for r in "${results[@]}"; do
        IFS='|' read -r cn f s sz <<< "${r}"
        printf "  %-20s %-10s %-12s %s\n" "${cn}" "${f}" "${s}x" "${sz}"
    done
    echo "  (test pattern source, includes the time to generate the frames)"
    echo ""
}

info_vpu() {
    printf "%b\n" "${BOLD}VPU Information${NC}"
    echo "─────────────────────────────────────────"
    echo "  Device     : ${VPU_DEVICE}"
    v4l2-ctl -d "${VPU_DEVICE}" --info 2>/dev/null | grep -E "Driver|Card|Version" | \
        sed 's/^/  /'
    echo ""
    echo "  Supported input formats :"
    v4l2-ctl -d "${VPU_DEVICE}" --list-formats-out 2>/dev/null | \
        grep -E "^\s+\[" | sed 's/^/    /'
    echo ""
    echo "  Supported output codecs :"
    v4l2-ctl -d "${VPU_DEVICE}" --list-formats 2>/dev/null | \
        grep -E "^\s+\[" | sed 's/^/    /'
    echo ""
    echo "  Kernel module :"
    modinfo amvx 2>/dev/null | grep -E "filename|version" | sed 's/^/    /'
    echo ""
    echo "  GStreamer :"
    gst-launch-1.0 --version 2>/dev/null | sed -n 2p | sed 's/^/    /'
    local enc
    for enc in v4l2h264enc v4l2h265enc v4l2vp8enc v4l2vp9enc; do
        if have_element "${enc}"; then
            echo "    ${enc} ✓"
        else
            echo "    ${enc} ✗"
        fi
    done
    echo ""
}

